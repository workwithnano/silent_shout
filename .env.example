# Release credentials for the Makefile's archive and App Store Connect targets. `make` copies
# this file to .env (gitignored) on first use; fill in the blanks there, never here.

# Apple Developer team id used for code signing (developer.apple.com > Membership). It is passed
# to xcodebuild on the command line and is never written into project.pbxproj.
# Required by: make archive / ipa / upload.
DEVELOPMENT_TEAM=

# App Store Connect API key. Must be a TEAM key (App Store Connect > Users and Access >
# Integrations), which comes with an Issuer ID. Required by: make upload, check-build-number,
# asc-bundle-id, asc-bundle-id-register, asc-app (and by archive, to create signing assets).
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the downloaded AuthKey_<KEY_ID>.p8 file. Keep it outside the repo.
ASC_KEY_PATH=
